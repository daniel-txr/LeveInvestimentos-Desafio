<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LeveInvestimentos.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeveInvestimentos.Domain\LeveInvestimentos.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Somente o pacote "Abstractions": a camada Application depende apenas do CONTRATO de
         logging (ILogger<T>), nunca de uma implementação concreta (Serilog, console, etc.),
         mantendo a inversão de dependência também aqui. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
