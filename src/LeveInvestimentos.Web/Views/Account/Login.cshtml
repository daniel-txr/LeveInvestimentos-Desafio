@model LoginDTO
@{
    ViewData["Title"] = "Entrar";
}

<div class="uk-flex uk-flex-center uk-margin-large-top">
    <div class="uk-width-1-1 uk-width-1-3@m">
        <div class="uk-card uk-card-default uk-card-body uk-box-shadow-medium">
            <h3 class="uk-card-title uk-text-center">Leve Investimentos</h3>
            <p class="uk-text-center uk-text-meta">Acesse com seu e-mail e senha</p>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="uk-alert-danger" uk-alert></div>

                <div class="uk-margin">
                    <label class="uk-form-label" asp-for="Email"></label>
                    <input asp-for="Email" class="uk-input" autocomplete="username" />
                    <span asp-validation-for="Email" class="uk-text-danger uk-text-small"></span>
                </div>

                <div class="uk-margin">
                    <label class="uk-form-label" asp-for="Senha"></label>
                    <input asp-for="Senha" class="uk-input" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="uk-text-danger uk-text-small"></span>
                </div>

                <button type="submit" class="uk-button uk-button-primary uk-width-1-1">Entrar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
