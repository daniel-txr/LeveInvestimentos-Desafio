<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Leve Investimentos</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.21.6/dist/css/uikit.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.21.6/dist/js/uikit.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/uikit@3.21.6/dist/js/uikit-icons.min.js"></script>
</head>
<body>
    <nav class="uk-navbar-container uk-navbar-transparent uk-box-shadow-small" uk-navbar>
        <div class="uk-container">
            <div uk-navbar>
                <div class="uk-navbar-left">
                    <a class="uk-navbar-item uk-logo" asp-controller="Home" asp-action="Index">
                        Leve Investimentos
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="uk-navbar-nav">
                            <li><a asp-controller="Home" asp-action="Index">Início</a></li>
                            <li><a asp-controller="Tarefas" asp-action="Index">Tarefas</a></li>
                            @if (User.FindFirst(LeveInvestimentos.Web.Authorization.ClaimsPersonalizados.Perfil)?.Value == "Gestor")
                            {
                                <li><a asp-controller="Usuarios" asp-action="Index">Usuários</a></li>
                            }
                        </ul>
                    }
                </div>
                <div class="uk-navbar-right">
                    <div class="uk-navbar-item">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="uk-container uk-margin-top uk-margin-bottom">
        @if (TempData["MensagemSucesso"] is not null)
        {
            <div class="uk-alert-success" uk-alert>
                <a class="uk-alert-close" uk-close></a>
                <p>@TempData["MensagemSucesso"]</p>
            </div>
        }
        @if (TempData["MensagemErro"] is not null)
        {
            <div class="uk-alert-danger" uk-alert>
                <a class="uk-alert-close" uk-close></a>
                <p>@TempData["MensagemErro"]</p>
            </div>
        }

        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="uk-section uk-section-muted uk-section-xsmall uk-margin-large-top">
        <div class="uk-container uk-text-center uk-text-meta">
            &copy; @DateTime.Now.Year - Leve Investimentos
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
