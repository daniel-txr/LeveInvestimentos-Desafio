@using LeveInvestimentos.Web.Authorization
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="uk-flex uk-flex-middle">
        <span class="uk-margin-small-right uk-text-small">
            <span uk-icon="icon: user"></span>
            @User.FindFirst(ClaimsPersonalizados.NomeCompleto)?.Value
            @if (User.FindFirst(ClaimsPersonalizados.Perfil)?.Value == "Gestor")
            {
                <span class="uk-badge">Gestor</span>
            }
        </span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="uk-margin-remove">
            <button type="submit" class="uk-button uk-button-default uk-button-small">Sair</button>
        </form>
    </div>
}
