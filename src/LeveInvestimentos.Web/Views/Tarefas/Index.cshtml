@model LeveInvestimentos.Application.DTOs.PaginacaoResultado<LeveInvestimentos.Application.DTOs.TarefaListaDTO>
@{
    ViewData["Title"] = "Tarefas";
    bool isGestor = ViewBag.IsGestor;
}

<div class="uk-flex uk-flex-between uk-flex-middle uk-margin-bottom">
    <h2 class="uk-margin-remove">@(isGestor ? "Tarefas atribuídas pela equipe" : "Minhas tarefas")</h2>
    @if (isGestor)
    {
        <a class="uk-button uk-button-primary" asp-controller="Tarefas" asp-action="Create">
            <span uk-icon="icon: plus"></span> Nova tarefa
        </a>
    }
</div>

@if (!Model.Itens.Any())
{
    <div class="uk-alert-primary" uk-alert><p>Nenhuma tarefa encontrada.</p></div>
}
else
{
    <div class="uk-grid-match uk-child-width-1-2@m uk-child-width-1-3@l" uk-grid>
        @foreach (var tarefa in Model.Itens)
        {
            var concluida = tarefa.Status == LeveInvestimentos.Domain.Enums.StatusTarefa.Concluida;
            var classeCard = concluida ? "uk-card-tarefa-concluida" : (tarefa.Atrasada ? "uk-card-tarefa-atrasada" : "");

            <div>
                <div class="uk-card uk-card-default uk-card-body uk-box-shadow-small @classeCard">
                    <p class="uk-margin-remove">@tarefa.Mensagem</p>
                    <p class="uk-text-meta uk-margin-small-top uk-margin-remove-bottom">
                        Prazo: @tarefa.DataLimite.ToString("dd/MM/yyyy")
                    </p>

                    @if (isGestor)
                    {
                        <p class="uk-text-meta uk-margin-remove-top">Responsável: @tarefa.UsuarioResponsavelNome</p>
                    }
                    else
                    {
                        <p class="uk-text-meta uk-margin-remove-top">Atribuída por: @tarefa.UsuarioGestorNome</p>
                    }

                    <div class="uk-margin-small-top">
                        @if (concluida)
                        {
                            <span class="uk-label uk-label-success">Concluída em @tarefa.DataConclusao?.ToString("dd/MM/yyyy")</span>
                        }
                        else if (tarefa.Atrasada)
                        {
                            <span class="uk-label uk-label-danger">Atrasada</span>
                        }
                        else
                        {
                            <span class="uk-label">Pendente</span>
                        }
                    </div>

                    @if (!isGestor && !concluida)
                    {
                        <form asp-controller="Tarefas" asp-action="Concluir" asp-route-id="@tarefa.Id" asp-route-pagina="@Model.PaginaAtual" method="post" class="uk-margin-small-top">
                            <button type="submit" class="uk-button uk-button-small uk-button-primary">
                                Marcar como concluída
                            </button>
                        </form>
                    }

                    @if (isGestor)
                    {
                        <div class="uk-margin-small-top">
                            @if (!concluida)
                            {
                                <a class="uk-icon-link uk-margin-small-right" uk-icon="icon: pencil" asp-action="Edit" asp-route-id="@tarefa.Id" title="Editar"></a>
                            }
                            <form asp-controller="Tarefas" asp-action="Excluir" asp-route-id="@tarefa.Id" asp-route-pagina="@Model.PaginaAtual" method="post" class="uk-display-inline">
                                <button type="submit" class="uk-icon-link uk-text-danger" uk-icon="icon: trash" title="Excluir"
                                        onclick="return confirm('Excluir esta tarefa? Essa ação não pode ser desfeita.');"></button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <p class="uk-text-meta uk-text-center uk-margin-top">
        Mostrando @Model.Itens.Count() de @Model.TotalRegistros tarefa(s) — página @Model.PaginaAtual de @Model.TotalPaginas
    </p>

    ViewData["PaginaAtual"] = Model.PaginaAtual;
    ViewData["TotalPaginas"] = Model.TotalPaginas;

    <partial name="_Paginacao" />
}
