@model UsuarioCadastroViewModel
@{
    ViewData["Title"] = "Novo usuário";
}

<h2>Cadastrar novo usuário</h2>

<div class="uk-card uk-card-default uk-card-body uk-box-shadow-small">
    <form asp-controller="Usuarios" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="uk-alert-danger" uk-alert></div>

        <div uk-grid>
            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="NomeCompleto"></label>
                <input asp-for="NomeCompleto" class="uk-input" />
                <span asp-validation-for="NomeCompleto" class="uk-text-danger uk-text-small"></span>
            </div>
            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="DataNascimento"></label>
                <input asp-for="DataNascimento" class="uk-input" />
                <span asp-validation-for="DataNascimento" class="uk-text-danger uk-text-small"></span>
            </div>

            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="TelefoneFixo"></label>
                <input asp-for="TelefoneFixo" class="uk-input" placeholder="(11) 3333-4444" />
                <span asp-validation-for="TelefoneFixo" class="uk-text-danger uk-text-small"></span>
            </div>
            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="TelefoneCelular"></label>
                <input asp-for="TelefoneCelular" class="uk-input" placeholder="(11) 99999-8888" />
                <span asp-validation-for="TelefoneCelular" class="uk-text-danger uk-text-small"></span>
            </div>

            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="Email"></label>
                <input asp-for="Email" class="uk-input" autocomplete="off" />
                <span asp-validation-for="Email" class="uk-text-danger uk-text-small"></span>
            </div>
            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="Perfil"></label>
                <select asp-for="Perfil" asp-items="Html.GetEnumSelectList<PerfilUsuario>()" class="uk-select"></select>
                <span asp-validation-for="Perfil" class="uk-text-danger uk-text-small"></span>
            </div>

            <div class="uk-width-1-1">
                <label class="uk-form-label" asp-for="Endereco"></label>
                <input asp-for="Endereco" class="uk-input" />
                <span asp-validation-for="Endereco" class="uk-text-danger uk-text-small"></span>
            </div>

            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="Senha"></label>
                <input asp-for="Senha" class="uk-input" autocomplete="new-password" />
                <span asp-validation-for="Senha" class="uk-text-danger uk-text-small"></span>
            </div>
            <div class="uk-width-1-2@s">
                <label class="uk-form-label" asp-for="ConfirmacaoSenha"></label>
                <input asp-for="ConfirmacaoSenha" class="uk-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmacaoSenha" class="uk-text-danger uk-text-small"></span>
            </div>

            <div class="uk-width-1-1">
                <label class="uk-form-label" asp-for="Foto"></label>
                <div uk-form-custom="target: true">
                    <input asp-for="Foto" type="file" accept="image/*" />
                    <input class="uk-input uk-form-width-large" type="text" placeholder="Selecione uma foto (opcional)" disabled>
                </div>
                <span asp-validation-for="Foto" class="uk-text-danger uk-text-small"></span>
            </div>
        </div>

        <div class="uk-margin-top">
            <button type="submit" class="uk-button uk-button-primary">Salvar</button>
            <a class="uk-button uk-button-default" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
